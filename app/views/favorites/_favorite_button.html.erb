<%# locals: recipe %>
<div id="favorite_button_<%= recipe.id %>" class="favorite-button">
  <% if logged_in? %>
    <% if recipe.favorited_by?(current_user) %>
      <%= button_to recipe_favorite_path(recipe), method: :delete,
            class: "favorite-toggle favorited", form: { data: { turbo: true } } do %>
        <span class="heart-icon">&#9829;</span>
      <% end %>
    <% else %>
      <%= button_to recipe_favorite_path(recipe), method: :post,
            class: "favorite-toggle", form: { data: { turbo: true } } do %>
        <span class="heart-icon">&#9829;</span>
      <% end %>
    <% end %>
  <% else %>
    <span class="favorite-toggle disabled"><span class="heart-icon">&#9829;</span></span>
  <% end %>
</div>
