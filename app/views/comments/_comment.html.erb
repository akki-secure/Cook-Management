<div id="<%= dom_id(comment) %>" class="comment">
  <div class="comment-meta">
    <span class="comment-author"><%= comment.user.name %></span>
    <span class="comment-date"><%= comment.created_at.strftime("%Y/%m/%d %H:%M") %></span>
  </div>
  <p class="comment-body"><%= simple_format(comment.body) %></p>
  <% if logged_in? && current_user == comment.user %>
    <div class="comment-actions">
      <%= link_to "編集", edit_comment_path(comment), class: "link-edit" %>
      <%= button_to "削除", comment_path(comment), method: :delete,
            class: "link-delete", form: { data: { turbo_confirm: "削除しますか?" } } %>
    </div>
  <% end %>
</div>
