<h1>ガチャ</h1>

<div class="gamification-summary"
     data-controller="gacha"
     data-gacha-pull-url-value="<%= gacha_path %>"
     data-gacha-seven-url-value="<%= gacha_seven_path %>"
     data-gacha-csrf-value="<%= form_authenticity_token %>"
     data-gacha-sprite-map-value="<%= Monster.pluck(:sprite_key).index_with { |k| image_path("monsters/#{k}") }.to_json %>"
     data-gacha-coin-icon-value="<%= image_path('coins/coin.png') %>"
     data-gacha-machine-icon-value="<%= image_path('gacha_machine.png') %>"
     data-gacha-knob-frames-value="<%= (1..4).map { |i| image_path("gacha/gacha_knob_turn_#{i}.png") }.to_json %>"
     data-gacha-capsule-closed-map-value="<%= %w[blue green pink purple red yellow].index_with { |c| image_path("gacha/capsule_#{c}.png") }.to_json %>"
     data-gacha-capsule-open-map-value="<%= %w[blue green pink purple red yellow].index_with { |c| image_path("gacha/capsule_open_#{c}.png") }.to_json %>"
     data-gacha-coin-sound-value="<%= asset_path('coin_drop.wav') %>"
     data-gacha-knob-sound-value="<%= asset_path('gacha_knob_turn.wav') %>"
     data-gacha-capsule-drop-sound-value="<%= asset_path('capsule_drop.wav') %>"
     data-gacha-hit-sound-value="<%= asset_path('gacha_hit.wav') %>"
     data-gacha-miss-sound-value="<%= asset_path('gacha_miss.wav') %>"
     data-gacha-cost-value="<%= Gamification::GachaRules::COST %>"
     data-gacha-seven-cost-value="<%= Gamification::SevenGachaPullService::COST %>">
  <p><strong>所持コイン:</strong> <span data-gacha-target="coinLabel"><%= current_user.coins %></span>枚</p>
  <p><strong>所持レインボーコイン:</strong> <span data-gacha-target="rainbowCoinLabel"><%= current_user.rainbow_coins %></span>枚</p>
  <p>
    <strong>所持モンスター数(上限<%= Gamification::GachaRules::MAX_OWNED_MONSTERS %>体):</strong>
    <%= current_user.user_monsters.count %> / <%= Gamification::GachaRules::MAX_OWNED_MONSTERS %>
    <%= link_to "モンスターを逃がす", user_monsters_path %>
  </p>

  <div class="gacha-machine-area">
    <img data-gacha-target="coinSprite" class="gacha-coin-sprite" alt="">
    <img data-gacha-target="knobSprite" class="gacha-knob-sprite" alt="">
    <img data-gacha-target="capsuleSprite" class="gacha-capsule-sprite" alt="">
    <img data-gacha-target="machineSprite" class="gacha-machine-sprite" alt="ガチャマシン">
    <div data-gacha-target="domeSwirl" class="gacha-dome-swirl" aria-hidden="true">
      <% %w[red blue yellow green purple pink].each_with_index do |color, i| %>
        <img class="gacha-dome-capsule gacha-dome-capsule--<%= i + 1 %>" src="<%= image_path("gacha/capsule_#{color}.png") %>" alt="">
      <% end %>
    </div>
  </div>
  <div class="gacha-reveal" data-gacha-target="revealHolder"></div>
  <p class="gacha-result-text" data-gacha-target="resultLabel"></p>

  <button type="button" class="btn" data-gacha-target="pullButton" data-action="gacha#pull"
          <%= "disabled" if current_user.coins < Gamification::GachaRules::COST %>>ガチャを回す(消費<%= Gamification::GachaRules::COST %>コイン)</button>

  <button type="button" class="btn" data-gacha-target="sevenButton" data-action="gacha#pullSeven"
          <%= "disabled" if current_user.rainbow_coins < Gamification::SevenGachaPullService::COST %>>🌈 7連ガチャ(消費<%= Gamification::SevenGachaPullService::COST %>レインボーコイン)</button>
</div>

<p><%= link_to "マイページに戻る", profile_path %></p>
