<%= form_with model: recipe, local: true do |f| %>
  <% if recipe.errors.any? %>
    <div class="error-messages">
      <ul>
        <% recipe.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= f.label :title, "レシピ名" %>
    <%= f.text_field :title, required: true %>
  </div>

  <div class="form-group">
    <%= f.label :category_id, "カテゴリ" %>
    <%= f.collection_select :category_id, Category.order(:name), :id, :name, include_blank: "選択してください" %>
  </div>

  <div class="form-group">
    <%= f.label :tag_names, "タグ(カンマ区切り)" %>
    <%= text_field_tag "recipe[tag_names]", recipe.tags.map(&:name).join(", "), placeholder: "例: 和食, 簡単, 時短" %>
  </div>

  <div class="form-group">
    <%= f.label :cooking_time, "調理時間(分)" %>
    <%= f.number_field :cooking_time, min: 1 %>
  </div>

  <div class="form-group">
    <%= f.label :servings, "人数分" %>
    <%= f.number_field :servings, min: 1 %>
  </div>

  <div class="form-group">
    <%= f.label :description, "説明" %>
    <%= f.text_area :description %>
  </div>

  <div class="form-group">
    <%= f.label :instructions, "作り方" %>
    <%= f.text_area :instructions, required: true %>
  </div>

  <div class="form-group">
    <%= f.label :image, "写真" %>
    <% if recipe.image.attached? %>
      <div><%= image_tag recipe.image, style: "max-width: 200px; display: block; margin-bottom: 8px;" %></div>
    <% end %>
    <%= f.file_field :image, accept: "image/*" %>
  </div>

  <div class="form-group" data-controller="nested-fields">
    <label>材料</label>

    <div data-nested-fields-target="container">
      <%= f.fields_for :ingredients do |ingredient_form| %>
        <%= render "ingredient_fields", form: ingredient_form %>
      <% end %>
    </div>

    <template data-nested-fields-target="template">
      <%= f.fields_for :ingredients, Ingredient.new, child_index: "NEW_RECORD" do |ingredient_form| %>
        <%= render "ingredient_fields", form: ingredient_form %>
      <% end %>
    </template>

    <a href="#" class="btn btn-secondary" data-action="nested-fields#add">材料を追加</a>
  </div>

  <%= f.submit (recipe.persisted? ? "更新する" : "作成する"), class: "btn" %>
<% end %>
