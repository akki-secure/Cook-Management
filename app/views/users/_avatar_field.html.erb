<div class="form-group">
  <%= f.label :avatar_image, "アイコン画像" %>
  <% if f.object.persisted? && f.object.avatar_image.attached? %>
    <div><%= image_tag f.object.avatar_image, class: "avatar-icon avatar-icon--medium" %></div>
  <% end %>
  <%= f.file_field :avatar_image, accept: "image/*" %>
</div>
