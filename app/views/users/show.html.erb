<h1>マイページ</h1>

<div class="profile-summary">
  <%= avatar_tag(current_user, size: :medium) %>
  <p><strong>お名前:</strong> <%= current_user.name %></p>
  <p><strong>メールアドレス:</strong> <%= current_user.email %></p>
  <%= link_to "プロフィールを編集", edit_profile_path, class: "btn" %>
</div>

<div class="gamification-summary">
  <h2>料理人ステータス</h2>
  <p><strong>称号:</strong> <%= current_user.current_title&.name || "称号なし" %></p>
  <p><strong>レベル:</strong> <%= current_user.level %> / 100</p>
  <% next_exp = Gamification::LevelCalculator.next_level_total_exp(current_user.exp) %>
  <p>
    <strong>EXP:</strong> <%= current_user.exp %>
    <%= next_exp ? "(次のレベルまで #{next_exp - current_user.exp})" : "(最大レベルに到達しています)" %>
  </p>
  <p><strong>連続記録日数:</strong> <%= current_user.current_streak_days %>日（最長 <%= current_user.longest_streak_days %>日）</p>

  <%= link_to monsters_path, class: "zukan-entry" do %>
    <span class="book-btn" aria-hidden="true"><%= image_tag "cooking_book.png", alt: "" %></span>
    <span class="copy">
      <strong>モンスター図鑑</strong>
      <span>集めたモンスターを見る(<%= @owned_monster_count %> / <%= Monster.count %>体)</span>
    </span>
  <% end %>
  <% if @owned_monster_count.zero? %>
    <p class="page-lead">まだモンスターを獲得していません。写真付きでレシピを投稿してみましょう。</p>
  <% end %>
</div>

<h2>投稿したレシピ</h2>

<% if @recipes.any? %>
  <ul class="recipe-list">
    <% @recipes.each do |recipe| %>
      <li>
        <%= link_to recipe.title, recipe_path(recipe) %>
        <span class="recipe-meta"><%= recipe.category&.name %></span>
      </li>
    <% end %>
  </ul>
<% else %>
  <p>まだレシピを投稿していません。</p>
<% end %>
