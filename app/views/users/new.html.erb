<h1>新規登録</h1>

<%= form_with model: @user, url: signup_path, local: true do |f| %>
  <% if @user.errors.any? %>
    <div class="error-messages">
      <ul>
        <% @user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= f.label :name do %>お名前<span class="required-mark">※</span><% end %>
    <%= f.text_field :name, required: true %>
  </div>

  <div class="form-group">
    <%= f.label :email do %>メールアドレス<span class="required-mark">※</span><% end %>
    <%= f.email_field :email, required: true %>
  </div>

  <div class="form-group" data-controller="password-visibility">
    <%= f.label :password do %>パスワード(8文字以上)<span class="required-mark">※</span><% end %>
    <%= f.password_field :password, required: true, data: { password_visibility_target: "input" } %>
    <button type="button" class="password-toggle" aria-pressed="false"
            data-password-visibility-target="toggle"
            data-action="password-visibility#toggle">表示</button>
  </div>

  <div class="form-group" data-controller="password-visibility">
    <%= f.label :password_confirmation do %>パスワード(確認)<span class="required-mark">※</span><% end %>
    <%= f.password_field :password_confirmation, required: true, data: { password_visibility_target: "input" } %>
    <button type="button" class="password-toggle" aria-pressed="false"
            data-password-visibility-target="toggle"
            data-action="password-visibility#toggle">表示</button>
  </div>

  <%= f.submit "登録する", class: "btn" %>
<% end %>

<p><%= link_to "すでにアカウントをお持ちの方はこちら", login_path %></p>
