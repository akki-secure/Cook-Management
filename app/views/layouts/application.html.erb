<!DOCTYPE html>
<html>
  <head>
    <title>レシピ管理</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="site-header">
      <div class="container">
        <%= link_to "レシピ管理", root_path, class: "logo" %>
        <nav>
          <%= link_to "使い方", help_path %>
          <% if logged_in? %>
            <% logged_in_nav_items.each do |item| %>
              <%= link_to item[:label], item[:url] %>
            <% end %>
            <details class="user-menu" data-controller="dropdown" data-dropdown-target="menu">
              <summary class="current-user user-menu-trigger">
                <%= image_tag "avatars/#{current_user.avatar_key}.png", alt: "", class: "avatar-icon avatar-icon--small" %>
                <%= current_user.name %>さん
              </summary>
              <div class="user-menu-list">
                <%= button_to "ログアウト", logout_path, method: :delete, class: "link-button" %>
              </div>
            </details>
          <% else %>
            <% logged_out_nav_items.each do |item| %>
              <%= link_to item[:label], item[:url] %>
            <% end %>
          <% end %>
        </nav>
      </div>
    </header>

    <main class="container">
      <% if notice %>
        <p class="flash notice"><%= notice %></p>
      <% end %>
      <% if alert %>
        <p class="flash alert"><%= alert %></p>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
