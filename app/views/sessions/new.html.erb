<h1>ログイン</h1>

<%= form_with url: login_path, method: :post, local: true, html: { class: "auth-form" } do |f| %>
  <div class="form-group">
    <%= f.label :email, "メールアドレス" %>
    <%= f.email_field :email, required: true %>
  </div>

  <div class="form-group" data-controller="password-visibility">
    <%= f.label :password, "パスワード" %>
    <%= f.password_field :password, required: true, data: { password_visibility_target: "input" } %>
    <button type="button" class="password-toggle" aria-pressed="false"
            data-password-visibility-target="toggle"
            data-action="password-visibility#toggle">表示</button>
  </div>

  <p><%= link_to "パスワードをお忘れですか?", new_password_reset_path %></p>

  <%= f.submit "ログイン", class: "btn" %>
<% end %>

<p><%= link_to "アカウントをお持ちでない方はこちら", signup_path %></p>
